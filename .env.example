# Junjo server environment surface. Every consumer / deploy reads these
# from real env (Railway service vars, k8s secrets, .env for local dev).
# Copy to `.env` for local work; Railway sets these via the dashboard or
# `railway variables --set`.

# Required ----------------------------------------------------------------

# Postgres connection string. Railway's Postgres plugin exposes this as
# ${{Postgres.DATABASE_URL}} -- reference it directly when wiring the
# service variable so credential rotation flows through automatically.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Optional but strongly recommended --------------------------------------

# Bearer token gating /v1/admin/* (cross-game admin surface, used by the
# dashboard and by consumers that need to provision games / api keys
# programmatically). Without it every admin request 401s. Generate via:
#   openssl rand -hex 32
# Rotate by overwriting; the server reads at boot.
JUNJO_ADMIN_TOKEN=

# Public base URL of this deployment. Surfaced in invitation links and
# webhook delivery `User-Agent`. For Railway, set to the service's
# public domain once the deploy is up.
JUNJO_BASE_URL=https://your-junjo.example.com

# Optional ---------------------------------------------------------------

# Listen port. Defaults to 8787. Railway injects PORT automatically; no
# need to set this on Railway.
PORT=8787

NODE_ENV=production
LOG_LEVEL=info

# API-key rate limiter. Token bucket per-API-key-prefix. Set either to
# 0 to disable. Defaults: 600/min, burst 100.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=100

# Upper bound on the `?limit=` parameter for every list endpoint. The
# SDK and webhook worker honor whatever the server accepts, so raising
# this is purely a server-side decision.
JUNJO_MAX_PAGE_SIZE=100

# Webhook URL SSRF guard. Default rejects loopback / link-local /
# RFC1918 / IPv6 ULA destinations. Self-hosters running a receiver on
# the same machine set "true" or "1" to permit them. Production cloud
# leaves this unset.
WEBHOOK_ALLOW_PRIVATE_HOSTS=
