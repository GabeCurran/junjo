# Force LF line endings everywhere. Without this, git on Windows applies
# core.autocrlf at checkout time (LF in repo -> CRLF in working tree),
# which breaks biome's `lineEnding: "lf"` formatter check after any
# `git reset --hard` or `git checkout`.
* text=auto eol=lf

# Windows batch files keep CRLF: cmd.exe can mis-parse labels and
# `goto` targets in LF-only batch files.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary types - never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.jar binary
*.gz binary
*.rbxm binary
*.rbxmx binary
