{
  "name": "junjo",
  "private": true,
  "version": "0.0.0",
  "description": "Game-domain primitives for groups, ranks, and permissions.",
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "examples/*", "tools/*"],
  "scripts": {
    "dev": "node scripts/ensure-pg.mjs && concurrently --names pg,server,dashboard,docs --prefix-colors magenta,blue,green,yellow --kill-others-on-fail \"npm:dev:pg\" \"npm:dev:server\" \"npm:dev:dashboard\" \"npm:dev:docs\"",
    "dev:server-only": "node scripts/ensure-pg.mjs && npm run dev:server",
    "dev:pg": "docker logs -f --tail 20 junjo-test-pg",
    "dev:server": "npm run dev -w @junjo/server",
    "dev:dashboard": "npm run dev -w @junjo/dashboard -- -p 3000",
    "dev:docs": "npm run dev -w @junjo/docs -- -p 3001",
    "tunnel": "concurrently --names server,dashboard,docs --prefix-colors blue,green,yellow --kill-others-on-fail \"npm:tunnel:server\" \"npm:tunnel:dashboard\" \"npm:tunnel:docs\"",
    "tunnel:server": "cloudflared tunnel --url http://localhost:8787",
    "tunnel:dashboard": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:docs": "cloudflared tunnel --url http://localhost:3001",
    "db:seed:demo": "npm run db:seed:demo -w @junjo/server",
    "build": "npm run build -w @junjo/shared && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:style": "node scripts/check-style.mjs",
    "typecheck": "npm run build -w @junjo/shared && npm run build -w @junjo/sdk && npm run typecheck --workspaces --if-present",
    "screenshots": "npm run screenshots -w @junjo/screenshots --",
    "screenshots:dashboard": "npm run screenshots -w @junjo/screenshots -- --target=dashboard",
    "screenshots:docs": "npm run screenshots -w @junjo/screenshots -- --target=docs",
    "diagrams": "npm run diagrams -w @junjo/diagrams --",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx biome check --staged --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.11",
    "concurrently": "^9.2.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.0.0"
}
