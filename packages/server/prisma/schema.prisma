// Junjo data model. Postgres only. Committed migrations live in
// prisma/migrations; schema edits go through `npm run db:migrate:dev`.
// Run `prisma format` after edits.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Tenancy + identity
// =====================================================================

model Game {
  id        String   @id @default(cuid())
  name      String
  // Per-game configuration (Friends subsystem toggles + related knobs).
  // Validated against `PartialGameConfig` from `@junjo.io/shared` on write.
  // Read paths run the value through `resolveGameConfig` to fill missing
  // branches with defaults, so handlers always see a fully-populated tree.
  config    Json     @default("{}")
  // Optional shared identifier for `friends.scope = "network"`. Two
  // Game rows with the same `networkId` AND `friends.scope = "network"`
  // share visibility on UserRelationship rows.
  networkId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys            ApiKey[]
  groups             Group[]
  permissionDefs     PermissionDef[]
  externalIdentities ExternalIdentity[]
  webhookEndpoints   WebhookEndpoint[]
  userRelationships  UserRelationship[]
  friendTags         FriendTag[]
  userVisibilities   UserVisibility[]
  gameBans           GameBan[]
  banHistory         BanHistory[]
  auditEntries       AuditEntry[]
  linkCodes          LinkCode[]
  eventCounter       GameEventCounter?
  eventLog           EventLog[]
  groupVersions      GroupVersion[]
  moderationStates   ModerationState[]
  sanctions          Sanction[]
  sanctionHistory    SanctionHistory[]

  @@index([networkId])
}

// Last stream position handed out for a game. Incremented in the same
// transaction that writes the matching EventLog rows, so a rollback
// returns the numbers and positions are gapless. The row lock it takes
// is held until commit, which makes position order equal commit order
// within a game.
model GameEventCounter {
  gameId String @id
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seq    BigInt @default(0)
}

// A group's version: the stream position of the latest logged event
// about the group. Written only while the game's counter row is locked
// (see eventLog.ts), so a check against it there is serialized with
// every other write in the game. No foreign key to the group: a
// hard-deleted group's row is removed by the statement batch that logs
// the deletion.
model GroupVersion {
  groupId String @id
  gameId  String
  game    Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seq     BigInt

  @@index([gameId])
}

// Every event a game emits, in stream position order, kept for the
// retention window so a game stream can resume from a position.
// `payload` is the event as emitted; user ids are rendered per
// subscriber at delivery.
model EventLog {
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seq       BigInt
  eventId   String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@id([gameId, seq])
  @@index([createdAt])
}

model ApiKey {
  id                  String    @id @default(cuid())
  gameId              String
  game                Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Display prefix shown to the dev. The full key is `prefix.secret`.
  prefix              String    @unique
  hashedSecret        String
  // Optional operator-facing label; shown on audit entries the key wrote.
  name                String?
  // Ordered namespace preference for rendering user ids in responses and
  // SSE events read through this key. Empty means no preference.
  preferredNamespaces String[]  @default([])
  // Allows `GET /v1/export` with this key.
  canExport           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  revokedAt           DateTime?

  auditEntries       AuditEntry[]
  linkCodes          LinkCode[]
  idempotencyRecords IdempotencyRecord[]

  @@index([gameId])
}

// One stored outcome of a request sent with an `Idempotency-Key`,
// scoped to the key that sent it. `state` is "in_progress" while the
// first request runs and "completed" once its response is stored; a 5xx
// or a thrown error deletes the row so a retry runs again. Rows expire
// 24 hours after `createdAt`; an in-progress row older than five minutes
// is treated as abandoned and may be claimed by a retry.
model IdempotencyRecord {
  apiKeyId        String
  apiKey          ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  key             String
  // SHA-256 (hex) over the method, the path with its query, and the raw
  // body bytes.
  fingerprint     String
  state           String
  responseStatus  Int?
  responseBody    String?
  // The response headers a replay repeats (content type and entity tag).
  responseHeaders Json?
  createdAt       DateTime
  completedAt     DateTime?

  @@id([apiKeyId, key])
  @@index([createdAt])
}

// Junjo's own user table. Powers cross-game shared identity in cloud:
// the same human can have memberships in many games' groups, all
// keyed by the same junjoUserId.
model JunjoUser {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  externalIdentities ExternalIdentity[]
  groupMemberships   GroupMember[]
  auditEntriesActed  AuditEntry[]       @relation("AuditActor")
  userRelsAsActor    UserRelationship[] @relation("UserRelActor")
  userRelsAsTarget   UserRelationship[] @relation("UserRelTarget")
  friendTags         FriendTag[]
  userVisibilities   UserVisibility[]
  gameBans           GameBan[]
  banHistory         BanHistory[]
  moderationStates   ModerationState[]
  sanctions          Sanction[]
  sanctionHistory    SanctionHistory[]
}

// Maps a dev's external user id (whatever external id the game's auth
// provider issues) to a JunjoUser. Per game, so two different games
// can use the same external id without colliding.
model ExternalIdentity {
  id                   String    @id @default(cuid())
  gameId               String
  game                 Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  junjoUserId          String
  junjoUser            JunjoUser @relation(fields: [junjoUserId], references: [id], onDelete: Cascade)
  externalUserId       String
  createdAt            DateTime  @default(now())
  // When this id joined its current JunjoUser: creation time, reset on
  // link and unlink. Orders a person's ids for deterministic rendering.
  linkedAt             DateTime  @default(now())
  // This id's own display name. The by-name lookup matches it ignoring
  // case through an expression index on (gameId, lower(displayName))
  // created in the migration, which the schema language cannot express.
  displayName          String?
  // When `displayName` was last set; null while it is unset.
  displayNameUpdatedAt DateTime?
  // The newest audit entry in this id's game that targets this id or
  // names its person as actor; null while there is none. The last
  // activity catch-up job raises it a few seconds after each entry, and
  // a database trigger created in the migration, which the schema
  // language cannot express, starts a new identity from the entries
  // already written. An id moved to another person keeps its value.
  lastActivityAt       DateTime? @db.Timestamptz(3)

  linkCodes LinkCode[]

  @@unique([gameId, externalUserId])
  @@index([junjoUserId])
  // Backs the per-game batched junjoUserId -> externalUserId lookup used by
  // the members list endpoints (`WHERE gameId AND junjoUserId IN (...)`),
  // and the gameId-scoped existence checks in `findJunjoUserId`.
  @@index([gameId, junjoUserId])
}

// How far the last activity catch-up job has read the audit log: the
// (createdAt, id) of the newest entry it has applied. One row, created
// by the migration.
model LastActivityCursor {
  id        String   @id
  createdAt DateTime
  auditId   String
}

// Single-use code that links the redeeming id to the issuing id's
// person. Only the SHA-256 of the normalized code is stored; codes are
// short-lived and looked up by hash, so a slow hash buys nothing.
model LinkCode {
  id                 String           @id @default(cuid())
  gameId             String
  game               Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  codeHash           String
  externalIdentityId String
  externalIdentity   ExternalIdentity @relation(fields: [externalIdentityId], references: [id], onDelete: Cascade)
  apiKeyId           String?
  apiKey             ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  expiresAt          DateTime
  usedAt             DateTime?

  @@unique([gameId, codeHash])
  @@index([externalIdentityId])
  @@index([expiresAt])
}

// =====================================================================
// Groups
// =====================================================================

model Group {
  id            String    @id @default(cuid())
  gameId        String
  game          Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  kind          String
  name          String
  visibility    String // "public" | "invite-only" | "secret"
  metadata      Json      @default("{}")
  defaultRoleId String?
  // Optional shared-secret join gate. When non-null, `POST /:id/join`
  // requires the caller to send a matching `passcode` in the body in
  // addition to passing the visibility / ban checks. Stored as a
  // scrypt hash (apiKey.ts hashSecret/verifySecret); the plaintext is
  // never persisted. Orthogonal to visibility -- a public group with
  // a passcode is "discoverable but gated", an invite-only group with
  // a passcode is harmless (the join path is already blocked).
  passcodeHash  String?
  passcodeSetAt DateTime?
  // Optional parent for hierarchical group structures. Null means
  // top-level. Cycle-checked at write time.
  parentGroupId String?
  parentGroup   Group?    @relation("GroupParent", fields: [parentGroupId], references: [id])
  childGroups   Group[]   @relation("GroupParent")

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // Soft delete with 7-day undo. A nightly job hard-deletes rows whose
  // softDeletedAt is older than 7 days.
  softDeletedAt    DateTime?
  // Last time a member became or stopped being active. The idle sweeper
  // compares it with the kind's `idleDeleteHours`.
  memberActivityAt DateTime  @default(now())

  members      GroupMember[]
  roles        Role[]
  invitations  Invitation[]
  auditEntries AuditEntry[]
  banHistory   BanHistory[]
  relsAsA      GroupRelationship[] @relation("RelGroupA")
  relsAsB      GroupRelationship[] @relation("RelGroupB")

  @@index([gameId, name])
  @@index([gameId, kind])
  // Backs the idle-group sweeper's per-kind scan.
  @@index([gameId, kind, memberActivityAt])
  @@index([parentGroupId])
  // Backs the keyset paginated `GET /v1/groups` listing
  // (`WHERE gameId AND softDeletedAt IS NULL ORDER BY createdAt DESC, id DESC`).
  // Supersedes the bare `[gameId]` index since gameId is the leading column.
  @@index([gameId, createdAt(sort: Desc), id(sort: Desc)])
}

model GroupMember {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  junjoUserId String
  junjoUser   JunjoUser @relation(fields: [junjoUserId], references: [id], onDelete: Cascade)

  status       String // "active" | "invited" | "left" | "kicked" | "banned"
  metadata     Json    @default("{}")
  notesPublic  String?
  notesPrivate String?

  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  // Starts at 1 and rises by exactly one in the transaction of every
  // write that changes the member (status, roles, overrides, metadata,
  // notes, or the person it belongs to). No-op writes leave it alone.
  // Conditional writes compare it against `If-Match`.
  version     Int       @default(1)
  // Only meaningful when status="banned". Null = permanent ban; a value
  // in the past is treated as expired at read time (lazy expiry, no
  // sweeper). Cleared whenever the row transitions back to active.
  bannedUntil DateTime?

  // A member can hold multiple roles at once. The join table sits below.
  memberRoles         MemberRole[]
  permissionOverrides MemberPermissionOverride[]

  @@unique([groupId, junjoUserId])
  @@index([junjoUserId])
  @@index([groupId, status])
  // Backs the keyset paginated `GET /v1/groups/:id/members` listing
  // (`WHERE groupId ORDER BY joinedAt DESC, id DESC`).
  @@index([groupId, joinedAt(sort: Desc), id(sort: Desc)])
}

// =====================================================================
// Roles + permissions
// =====================================================================

model Role {
  id        String  @id @default(cuid())
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  // Higher = more authority. Used by "can-act-on" checks
  // (you can't kick a member whose top role priority >= yours).
  priority  Int
  color     String?
  isDefault Boolean @default(false)
  metadata  Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  memberRoles     MemberRole[]
  parentLinks     RoleParent[]     @relation("RoleChild")
  childLinks      RoleParent[]     @relation("RoleParentOf")

  @@unique([groupId, name])
  @@index([groupId, priority(sort: Desc)])
}

// A role inherits every entry of its parents, at one layer further from
// the member. Parent and child are always in the same group; writes are
// cycle-checked and depth-bounded at the application layer.
model RoleParent {
  roleId       String
  role         Role     @relation("RoleChild", fields: [roleId], references: [id], onDelete: Cascade)
  parentRoleId String
  parentRole   Role     @relation("RoleParentOf", fields: [parentRoleId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([roleId, parentRoleId])
  @@index([parentRoleId])
}

// Multi-role per member is V1 scope. A separate join table lets us
// add per-assignment data later (assigned-by, assigned-at) without
// schema gymnastics.
model MemberRole {
  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt    DateTime    @default(now())

  @@id([groupMemberId, roleId])
  @@index([roleId])
}

// Permission keys are open strings the game defines. We register the
// set of keys per game so the dashboard can list them and the SDK can
// validate them client-side.
model PermissionDef {
  id          String   @id @default(cuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  key         String
  description String?
  createdAt   DateTime @default(now())

  @@unique([gameId, key])
}

// One entry on a role: `value` true grants the key, false denies it.
model RolePermission {
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  value         Boolean  @default(true)
  grantedAt     DateTime @default(now())
  // Conditions under which the entry applies; null means global.
  // `contextKey` is its canonical form ("" for global) and is part of
  // the identity, so one key can be held globally and per context.
  context       Json?
  contextKey    String   @default("")

  @@id([roleId, permissionKey, contextKey])
  @@index([permissionKey])
}

// Member-level override. Wins over role-derived permissions, in either
// direction (grant or revoke).
model MemberPermissionOverride {
  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)
  permissionKey String
  grant         Boolean
  setAt         DateTime    @default(now())
  setByUserId   String?
  // As on `RolePermission`.
  context       Json?
  contextKey    String      @default("")

  @@id([groupMemberId, permissionKey, contextKey])
  @@index([permissionKey])
}

// =====================================================================
// Group relationships (Minecraft Factions style)
// =====================================================================

// Stored *directed* (A -> B). Symmetric relationships are two rows.
// This avoids the "is A < B or B < A?" canonicalization mess and lets
// asymmetric cases ("A sees B as enemy, B sees A as neutral") exist.
// The SDK exposes a `mutual: true` helper that writes both rows.
model GroupRelationship {
  groupAId    String
  groupA      Group    @relation("RelGroupA", fields: [groupAId], references: [id], onDelete: Cascade)
  groupBId    String
  groupB      Group    @relation("RelGroupB", fields: [groupBId], references: [id], onDelete: Cascade)
  type        String // "ally" | "enemy" | "neutral" | dev-defined
  since       DateTime @default(now())
  // null when set by the server itself with no acting user (no
  // auth-adapter actor wired yet in V1; parallels Invitation.createdByUserId
  // and MemberPermissionOverride.setByUserId).
  setByUserId String?

  @@id([groupAId, groupBId])
  @@index([groupBId])
}

// =====================================================================
// User relationships (Friends + blocks)
// =====================================================================

// Stored *directed* (actor -> target), mirroring `GroupRelationship`.
// `type` discriminates the three lifecycle states the table holds:
//
//   - "request"  : an outbound friend request awaiting accept/decline.
//                  One row, actor -> target. respondedAt stays null
//                  until accept (then row may be promoted to "friend"
//                  + a mirror row created) or decline (row deleted).
//   - "friend"   : an accepted friendship. ALWAYS exists as two rows
//                  (actor -> target AND target -> actor) so "is X a
//                  friend of Y?" is a single-row read on either side.
//   - "blocked"  : a one-directional block. One row, actor -> target.
//                  The target is not notified. Adding a block also
//                  removes any existing "request" or "friend" rows in
//                  either direction in the same transaction.
//
// `gameId` carries scope semantics: rows are always written with their
// originating gameId. When a Game's `config.friends.scope = "network"`
// AND the Game has a non-null `networkId`, read queries union across
// every Game with the same networkId. Flipping scope back to per-game
// narrows visibility on read; data is never dropped.
model UserRelationship {
  id                String    @id @default(cuid())
  gameId            String
  game              Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  actorJunjoUserId  String
  actor             JunjoUser @relation("UserRelActor", fields: [actorJunjoUserId], references: [id], onDelete: Cascade)
  targetJunjoUserId String
  target            JunjoUser @relation("UserRelTarget", fields: [targetJunjoUserId], references: [id], onDelete: Cascade)
  type              String // "request" | "friend" | "blocked"
  createdAt         DateTime  @default(now())
  // Set when a "request" row is accepted (and the row promoted to
  // "friend"). Null while the request is still pending; null on rows
  // that were created directly as "friend" (e.g. when
  // requestsRequired=false) or as "blocked".
  respondedAt       DateTime?
  metadata          Json      @default("{}")

  relationshipTags UserRelationshipTag[]

  @@unique([gameId, actorJunjoUserId, targetJunjoUserId, type])
  // Backs inbound queries: my pending requests, my received friend
  // mirror rows, anyone who has me blocked.
  @@index([gameId, targetJunjoUserId, type])
  // Backs outbound queries: my friends list, my outbound requests,
  // my blocklist.
  @@index([gameId, actorJunjoUserId, type])
}

// Per-(user, game) tag for organizing the user's friend list. Tags are
// private to the owner: only the user that created the tag sees it
// applied to their friend rows. Tags only attach to the OWNER-side
// friend row, never the mirror, so each party can tag friendships
// independently.
model FriendTag {
  id          String    @id @default(cuid())
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  junjoUserId String
  junjoUser   JunjoUser @relation(fields: [junjoUserId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  createdAt   DateTime  @default(now())

  relationshipTags UserRelationshipTag[]

  @@unique([gameId, junjoUserId, name])
  @@index([gameId, junjoUserId])
}

// Many-to-many join between a friend row and the tags applied to it.
// Both sides cascade: deleting the friendship or the tag removes the
// join row. The tag's gameId+junjoUserId must match the friend row's
// gameId+actorJunjoUserId; this is enforced at the application layer
// rather than via SQL since the cross-table constraint would require
// triggers or check constraints.
model UserRelationshipTag {
  userRelationshipId String
  userRelationship   UserRelationship @relation(fields: [userRelationshipId], references: [id], onDelete: Cascade)
  friendTagId        String
  friendTag          FriendTag        @relation(fields: [friendTagId], references: [id], onDelete: Cascade)
  taggedAt           DateTime         @default(now())

  @@id([userRelationshipId, friendTagId])
  @@index([friendTagId])
}

// Per-(user, game) preference: who can see this user's friend list.
// Stored as its own table (not on ExternalIdentity) so a user can have
// a visibility setting in a game without yet having an ExternalIdentity
// binding (i.e., they were friended via direct junjoUserId before
// joining any group in this game).
//
// `friendsListVisibility`: "private" | "friends-only" | "public".
// Validated against the game's `config.friends.visibility.allowed`
// whitelist on write so admins can constrain the menu of allowed
// values. Reads fall back to `config.friends.visibility.default` when
// no row exists.
model UserVisibility {
  gameId                String
  game                  Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  junjoUserId           String
  junjoUser             JunjoUser @relation(fields: [junjoUserId], references: [id], onDelete: Cascade)
  friendsListVisibility String    @default("private")
  updatedAt             DateTime  @updatedAt

  @@id([gameId, junjoUserId])
  @@index([junjoUserId])
}

// =====================================================================
// Invitations
// =====================================================================

model Invitation {
  id              String    @id @default(cuid())
  groupId         String
  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code            String    @unique
  roleId          String?
  // null = open code/link invite. Set = direct push to a specific user.
  targetUserId    String?
  // null when issued by the server itself (no auth-adapter actor wired yet
  // in V1; parallels AuditEntry.actorUserId).
  createdByUserId String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?
  usedByUserId    String?

  @@index([groupId, expiresAt])
}

// =====================================================================
// Audit log
// =====================================================================

// Append-only by convention (no `update` calls in the server). Lives
// in its own table because retention policies and indexing patterns
// differ from operational tables, and because future log-shipping
// (S3 cold storage on the Pro tier) will be easier to bolt on.
model AuditEntry {
  id          String     @id @default(cuid())
  // Denormalized from group.gameId for query efficiency on the per-game
  // admin audit feed and to support game-scoped events (groupId=null
  // when the action is game-wide rather than tied to a single group --
  // e.g. game.user.banned / game.user.unbanned).
  gameId      String
  game        Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // null when an action is taken by the system (invitation expiry,
  // soft-delete cleanup, etc.).
  actorUserId String?
  actor       JunjoUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetId    String?
  payload     Json       @default("{}")
  // The API key whose request wrote this entry; null for dashboard and
  // system writes. Stamped centrally by the audit attribution extension.
  apiKeyId    String?
  apiKey      ApiKey?    @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([groupId, createdAt(sort: Desc)])
  @@index([gameId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  // Backs the per-game audit feed's target filter and the latest entry
  // per target that a new identity's `lastActivityAt` starts from
  // (`WHERE gameId AND targetId = ? ORDER BY createdAt DESC`).
  @@index([gameId, targetId, createdAt(sort: Desc)])
  // Backs the cross-game recent-activity feed, the 24 hour count and the
  // last activity catch-up job's read in (createdAt, id) order
  // (`ORDER BY createdAt DESC, id DESC`, `WHERE createdAt >= ?`).
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  // Backs the per-game audit feed filtered by action.
  @@index([gameId, action, createdAt(sort: Desc)])
}

// =====================================================================
// Webhooks
// =====================================================================

model WebhookEndpoint {
  id                  String    @id @default(cuid())
  gameId              String
  game                Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  url                 String
  // HMAC signing secret. Stored in recoverable form (HMAC requires the
  // secret on the signing side, unlike the API-key path which stores a
  // one-way hash). Surfaced to the dev only at create time.
  secret              String
  // Subset of event types this endpoint cares about. Empty = all.
  events              String[]
  // Wire format applied at delivery time. "junjo" (default) sends the raw
  // JunjoEvent JSON with HMAC headers; "discord" sends a Discord embed
  // payload and skips the HMAC (Discord webhooks authenticate via URL).
  // Slack and other targets land here in later phases.
  format              String    @default("junjo")
  // Ordered namespace preference for rendering user ids in payloads
  // delivered to this endpoint. Empty means no preference.
  preferredNamespaces String[]  @default([])
  createdAt           DateTime  @default(now())
  disabledAt          DateTime?
  // Rolling counter of consecutive failed delivery attempts (network
  // error, timeout, 5xx, retriable 4xx). Reset to 0 on any successful
  // delivery. The worker auto-flips `disabledAt` when this crosses the
  // configured threshold so a permanently-dead URL stops spamming logs.
  consecutiveFailures Int       @default(0)

  deliveries WebhookDelivery[]

  @@index([gameId])
}

// Postgres-backed delivery queue. Avoids a Redis dependency.
// Ordering is handled with `pg_advisory_xact_lock(endpointId)` in the
// dispatch worker so deliveries to the same endpoint can't race.
model WebhookDelivery {
  id                String          @id @default(cuid())
  webhookEndpointId String
  endpoint          WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  eventId           String
  payload           Json
  status            String // "pending" | "delivered" | "failed"
  attemptCount      Int             @default(0)
  responseStatus    Int?
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?
  createdAt         DateTime        @default(now())

  @@index([status, nextAttemptAt])
  @@index([webhookEndpointId, createdAt])
  // Backs the retention sweep of delivered and failed rows.
  @@index([status, createdAt])
}

// =====================================================================
// Bans (game-scoped)
// =====================================================================

// Game-wide ban applied across every group in the game. Per-group bans
// are expressed as `GroupMember.status = "banned"` instead. The two
// composes: enforcement sites check game-ban first, then group-ban.
// `expiresAt` enables time-bounded bans (lazy expiry: read paths treat
// an expired ban as not-banned; no background sweeper).
model GameBan {
  id             String    @id @default(cuid())
  gameId         String
  game           Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  junjoUserId    String
  junjoUser      JunjoUser @relation(fields: [junjoUserId], references: [id], onDelete: Cascade)
  bannedAt       DateTime  @default(now())
  expiresAt      DateTime? // null = permanent
  reason         String?
  // Resolved actor JunjoUser id; null when issued by server-side admin
  // with no auth-adapter actor wired (parallels AuditEntry.actorUserId).
  bannedByUserId String?
  // Free-text name of whoever issued the ban when that is not a Junjo
  // user. Stored and returned verbatim; never rendered or resolved.
  issuer         String?

  @@unique([gameId, junjoUserId])
  @@index([gameId, expiresAt])
  @@index([junjoUserId])
}

// Append-only ledger of every ban event (set + lift, group + game).
// Distinct from AuditEntry: AuditEntry is the generic per-game / per-
// group event log (where bans show up alongside everything else);
// BanHistory is a structured ban-only timeline keyed by (junjoUserId,
// gameId) so "show me this user's ban history" is a single indexed
// query instead of a JSON-payload scan. Lifecycle: every set/lift on
// either surface (per-group via groups.ban, game-wide via /v1/bans)
// writes one row here. Re-bans don't overwrite predecessors -- the
// row from the prior ban survives so the timeline reads cleanly.
model BanHistory {
  id               String    @id @default(cuid())
  gameId           String
  game             Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // The party affected. References JunjoUser; the dev's external id
  // can be resolved via ExternalIdentity at read time.
  junjoUserId      String
  junjoUser        JunjoUser @relation(fields: [junjoUserId], references: [id], onDelete: Cascade)
  // "game" for /v1/bans rows (gameId only); "group" for groups.ban
  // rows (groupId set).
  scope            String
  // Set on group-scope rows; null on game-scope rows. Cascades when
  // the group is hard-deleted (preserves the timeline otherwise).
  groupId          String?
  group            Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // "set" for ban issued; "lifted" for ban removed (manual unban or
  // expiry-based lift recorded by an operator).
  kind             String
  // Snapshot of the ban's reason at the time of the event; null on
  // lifts and on bans issued without a reason.
  reason           String?
  // Snapshot of the ban's expiry at the time of the event; null on
  // lifts and on permanent bans.
  expiresAt        DateTime?
  eventAt          DateTime  @default(now())
  // Resolved actor JunjoUser id when the dev's auth adapter is wired;
  // null otherwise (mirrors AuditEntry.actorUserId).
  actorJunjoUserId String?
  // Snapshot of GameBan.issuer on game-scope "set" rows; null otherwise.
  issuer           String?

  // "show me this user's ban history in this game"
  @@index([gameId, junjoUserId, eventAt(sort: Desc)])
  // "show me every ban event in this game in time order"
  @@index([gameId, eventAt(sort: Desc)])
  // Backs the cascade delete when a group is hard-deleted.
  @@index([groupId])
}

// Per-(game, person) moderation counter. Rises by exactly one in the
// transaction of every game ban or sanction create, change or lift. A
// person with no row has version 0. Conditional moderation writes
// compare it against `If-Match`.
model ModerationState {
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  junjoUserId String
  junjoUser   JunjoUser @relation(fields: [junjoUserId], references: [id], onDelete: Cascade)
  version     Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@id([gameId, junjoUserId])
  @@index([junjoUserId])
}

// =====================================================================
// Sanctions (game-scoped, game-defined types)
// =====================================================================

// The current or last sanction of one type for one person. Like GameBan:
// a lift deletes the row, an expired row counts as not sanctioned (lazy
// expiry) and is replaced by the next create.
model Sanction {
  id             String    @id @default(cuid())
  gameId         String
  game           Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  junjoUserId    String
  junjoUser      JunjoUser @relation(fields: [junjoUserId], references: [id], onDelete: Cascade)
  type           String
  reason         String?
  // Free text, stored and returned verbatim.
  issuer         String?
  // Resolved actor JunjoUser id when the request named one.
  issuedByUserId String?
  startedAt      DateTime  @default(now())
  expiresAt      DateTime?
  // Reserved for scoping a sanction to part of a game; not accepted on
  // the wire; always null.
  context        String?

  @@unique([gameId, junjoUserId, type])
  // Backs the keyset paginated active listing.
  @@index([gameId, startedAt(sort: Desc), id(sort: Desc)])
  @@index([junjoUserId])
}

// Append-only sanction timeline, the sanction counterpart of BanHistory:
// one "set" row per create or replace, one "lifted" row per lift.
model SanctionHistory {
  id               String    @id @default(cuid())
  gameId           String
  game             Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  junjoUserId      String
  junjoUser        JunjoUser @relation(fields: [junjoUserId], references: [id], onDelete: Cascade)
  type             String
  kind             String
  reason           String?
  expiresAt        DateTime?
  // The sanction's start on creates (or the stated start), the change
  // time on replacements, the lift time on "lifted" rows.
  eventAt          DateTime  @default(now())
  actorJunjoUserId String?
  issuer           String?

  @@index([gameId, junjoUserId, eventAt(sort: Desc)])
  @@index([gameId, eventAt(sort: Desc)])
}
