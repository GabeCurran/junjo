{
  "name": "@junjo.io/sdk",
  "version": "0.3.0",
  "description": "Junjo TypeScript client. Node + browser. Game-domain primitives for groups, ranks, and permissions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters/index.d.ts",
        "default": "./dist/adapters/index.js"
      },
      "require": {
        "types": "./dist/adapters/index.d.cts",
        "default": "./dist/adapters/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "size": "size-limit"
  },
  "dependencies": {
    "@junjo.io/shared": "0.3.0"
  },
  "devDependencies": {
    "jose": "^6.2.3",
    "@size-limit/preset-small-lib": "^12.1.0",
    "size-limit": "^12.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": "@junjo.io/sdk (main entry)",
      "path": "dist/index.js",
      "limit": "8 KB"
    },
    {
      "name": "@junjo.io/sdk/adapters",
      "path": "dist/adapters/index.js",
      "limit": "10 KB"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabeCurran/junjo.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://junjo.io",
  "bugs": {
    "url": "https://github.com/GabeCurran/junjo/issues"
  }
}
