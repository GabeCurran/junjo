%%{init: {'theme': 'neutral'}}%%
flowchart LR
  subgraph untrusted["Untrusted zone (player-controlled devices, hold no Junjo credential)"]
    browserApp["Browser client<br/>(SDK proxy: true, no authorization header)"]
    robloxClient["Roblox player client<br/>(LocalScript, RemoteEvent intent only)"]
    packagedClient["Packaged game client<br/>(shipped binary)"]
  end

  subgraph trusted["Trusted zone (dev-operated backends, hold the per-game jk_ key)"]
    proxyBackend["Dev's backend proxy<br/>(injects jk_, pins user ids to the session,<br/>allowlists routes)"]
    gameServer["Dev's game server<br/>(jk_ from env / secret manager)"]
    robloxServer["Roblox game server<br/>(jk_ via HttpService:GetSecret,<br/>identity from the Player object)"]
  end

  subgraph junjoApi["Junjo.io API"]
    v1["junjo-server /v1<br/>(scrypt-verifies jk_, scopes every row to that key's game)"]
    adminRoutes["/v1/admin/*<br/>(cross-game, admin token only; jk_ keys are rejected here)"]
  end

  subgraph operator["Operator surface"]
    dashboard["apps/dashboard<br/>(server-rendered, holds the jadm_ admin token;<br/>compared in constant time)"]
  end

  browserApp -- "session cookie or JWT (dev's own auth)" --> proxyBackend
  packagedClient -- "game protocol (dev's own transport)" --> gameServer
  robloxClient -- "RemoteEvent (payload is attacker-controlled;<br/>identity comes from the Player argument)" --> robloxServer

  proxyBackend -- "Bearer jk_... (injected server-side)" --> v1
  gameServer -- "Bearer jk_..." --> v1
  robloxServer -- "Bearer jk_..." --> v1

  dashboard -- "Bearer jadm_... (401 invalid_admin_token without it)" --> adminRoutes
  dashboard -- "Bearer jk_... (its own per-game key for game routes)" --> v1

  trusted -. "jk_ NEVER crosses this boundary:<br/>no browser bundle, no NEXT_PUBLIC_ / VITE_ env var,<br/>no ReplicatedStorage, no shipped client build" .-x untrusted
  linkStyle 8 stroke:#cc0000,stroke-width:2px,color:#cc0000
